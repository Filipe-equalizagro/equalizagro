# ─────────────────────────────────────────────────────────────
# Para rodar o projeto localmente (npm run dev):
#   1. Copie este arquivo para .env.local  (na raiz do projeto)
#   2. Preencha os valores reais — copie do painel da Vercel em
#      Settings → Environment Variables (mesmo projeto "equalizagro")
#   3. .env.local NUNCA é commitado (já está no .gitignore)
# ─────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL (Neon) — obrigatório para o site funcionar
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Token secreto enviado no header X-Aton-Key nas chamadas ao webhook
# do Consultor.IA (n8n). Opcional em dev — se vazio, o header não é enviado.
# NUNCA coloque o valor real aqui — apenas em .env.local (não commitado).
ATON_KEY=

# Envio de email (cadastro, recuperação de senha) — opcional em dev
RESEND_API_KEY=
EMAIL_FROM=

# n8n — opcional, já tem fallback padrão no código se não for definido
N8N_WEBHOOK_URL=
N8N_API_KEY=

# URLs públicas — NEXT_PUBLIC_APP_URL é usada em links de email (verificação,
# recuperação de senha) e nos redirecionamentos da Stripe. Domínio correto:
# https://www.equalizagro.com — NUNCA go2apply.com.br (esse domínio não existe).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=https://www.equalizagro.com

# Stripe — obrigatório para o fluxo de compra de créditos funcionar
# STRIPE_SECRET_KEY: Dashboard Stripe → Developers → API keys (sk_test_... em teste)
# STRIPE_WEBHOOK_SECRET: gerado ao cadastrar o endpoint de webhook no Dashboard Stripe (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Consultor Kow — roda dentro deste mesmo site agora (não é mais um app
# separado). Precisa de uma chave da Anthropic própria para a ferramenta
# (pode ser a mesma usada em outra parte do site, ou uma dedicada).
# NUNCA coloque o valor real aqui — apenas em .env.local (não commitado).
ANTHROPIC_API_KEY=

# Opcional — modelo de IA do Consultor Kow. Padrão: claude-haiku-4-5-20251001
KOW_MODEL=
